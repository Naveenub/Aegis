# ══════════════════════════════════════════════════════════════════════════════
# AEGIS — Environment Configuration
# Copy this file to .env and fill in values before starting any process.
# ══════════════════════════════════════════════════════════════════════════════

# ── AI API Keys ───────────────────────────────────────────────────────────────

# REQUIRED — Claude API key. Used by agent-runner.js for all agent calls.
ANTHROPIC_API_KEY=sk-ant-replace_with_your_key   # <-- fill this in

# REQUIRED FOR VECTOR MEMORY — OpenAI key for text-embedding-3-small.
# Without this, storeMemory() and searchMemory() are no-ops and agents
# receive no past-fix context. All other features work without it.
# OPENAI_API_KEY=sk-replace_with_your_openai_key

# ── Metered billing ───────────────────────────────────────────────────────────
# Postgres connection string for engine/usage-recorder.js. Metered events
# (workflow runs, agent-steps, input tokens, output tokens, sandbox-minutes) are appended here as
# an immutable, append-only log — separate from tenant-quota.js, which only
# tracks live rate-limit counters in Redis and cannot be replayed for billing.
DATABASE_URL=postgres://aegis:aegis@localhost:5432/aegis

# Stripe secret key used by engine/billing/stripe-reporter.js to push usage
# records via the metered Usage Records API (`npm run billing:flush`, run on
# a schedule). Each tenant also needs its Stripe subscription-item mapping
# registered via tenant-registry.js setBillingConfig(). Without this key the
# flush script fails closed — usage keeps accumulating in Postgres, nothing
# is lost, it just isn't reported until the key is set.
# STRIPE_SECRET_KEY=sk_live_replace_with_your_stripe_secret_key

# Publishable key (pk_...) for the self-serve signup page at /get-started. Safe to
# expose to browsers; served via GET /signup/config. Unset = the page shows a
# "contact us" fallback and /signup/config returns 503.
# STRIPE_PUBLISHABLE_KEY=pk_live_replace_with_your_stripe_publishable_key

# Required for POST /signup. Run `node scripts/stripe-setup.js` once (see its
# header) — it creates the Meters + prices and prints these lines.
# Base recurring price per tier:
# STRIPE_PRICE_STARTER=price_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_ENTERPRISE=price_...
# Metered (graduated, tier allowance free) price per tier x dimension, e.g.:
# STRIPE_PRICE_PRO_WORKFLOW_RUN=price_...
# STRIPE_PRICE_PRO_AGENT_STEP=price_...
# STRIPE_PRICE_PRO_TOKENS_IN=price_...
# STRIPE_PRICE_PRO_TOKENS_OUT=price_...
# STRIPE_PRICE_PRO_SANDBOX_MINUTES=price_...
# (repeat for STARTER and ENTERPRISE)
# Optional meter event_name overrides (defaults: aegis_workflow_run, aegis_agent_step,
# aegis_tokens_in, aegis_tokens_out, aegis_sandbox_minutes):
# STRIPE_METER_EVENT_TOKENS_IN=aegis_tokens_in
# STRIPE_METER_EVENT_TOKENS_OUT=aegis_tokens_out

# Signing secret for the inbound Stripe webhook (engine/billing/stripe-webhook.js),
# from the webhook endpoint's settings page in the Stripe dashboard. Endpoint:
# POST /webhooks/stripe, subscribed to checkout.session.completed, invoice.paid,
# invoice.payment_failed and customer.subscription.deleted.
# No secret = every request rejected (fails closed, same as STRIPE_SECRET_KEY above).
# STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_webhook_signing_secret

# ── API Authentication ────────────────────────────────────────────────────────
# Per-tenant API keys (recommended for multi-tenant deployments).
# Each tenant has its own secret key:
#
#   AEGIS_API_KEY_{TENANTID}=<secret>
#
# tenantId is upper-cased and non-alphanumeric characters become underscores,
# so tenant "acme-corp" maps to AEGIS_API_KEY_ACME_CORP.
#
# Examples:
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AEGIS_API_KEY_DEFAULT=replace_with_a_long_random_secret
# AEGIS_API_KEY_ACME=replace_with_a_long_random_secret_for_acme
# AEGIS_API_KEY_STAGING=replace_with_a_long_random_secret_for_staging
#
# Single-tenant fallback (backwards-compatible).
# When set, this key grants access to the "default" tenant only.
# Ignored if AEGIS_API_KEY_DEFAULT is also set.
# AEGIS_API_KEY=replace_with_a_long_random_secret

# ── Server ────────────────────────────────────────────────────────────────────

# HTTP port for the API server (default: 3000).
PORT=3000

# Comma-separated list of tenant IDs to register at boot.
# These tenants are created in Redis on startup so the first request works
# without a prior POST /tenants call.
AEGIS_TENANTS=default

# ── Queue backend ─────────────────────────────────────────────────────────────
# Which job-queue implementation engine/queue.js delegates to.
#   bullmq         (default) — Redis-backed, native per-job priority (REDIS_URL).
#   sqs            — Amazon SQS. 4 queues/tenant (one per priority tier) are
#                    created on first use. Requires AWS credentials in the
#                    environment; region via AWS_REGION (default us-east-1).
#   redis-streams  — Redis Streams. 4 streams/tenant (one per priority tier)
#                    + consumer groups, created on first use (REDIS_URL).
# QUEUE_BACKEND=bullmq

# ── Human-in-the-loop approval gate ──────────────────────────────────────────
# Controls whether patches are applied automatically or held for human review.
#
# CLAUDE_AUTONOMY=true  (default) — autonomous mode, patches applied immediately
# CLAUDE_AUTONOMY=false           — supervised mode, every patch held for review
#
# MODE=autonomous  (default) — same as CLAUDE_AUTONOMY=true
# MODE=approval               — same as CLAUDE_AUTONOMY=false
#
# Either variable alone is sufficient. If both are set, approval is required
# when either requests it. Individual steps can override via requiresApproval.
CLAUDE_AUTONOMY=true
MODE=autonomous

# ── Idempotency ───────────────────────────────────────────────────────────────
# Idempotency key TTL in seconds (default: 604800 = 7 days).
# Keys older than this are expired automatically by Redis.
# Set lower in high-throughput deployments to control memory; never set below
# the longest realistic workflow duration or retries may re-apply patches.
AEGIS_IDEM_TTL_SECONDS=604800

# ── Concurrency control ───────────────────────────────────────────────────────
# Maximum parallel steps per priority tier per workflow.
# CRITICAL steps are the most time-sensitive (DLQ retries); LOW steps are
# background operations that should not starve higher-priority work.
AEGIS_CONCURRENCY_CRITICAL=8
AEGIS_CONCURRENCY_HIGH=5
AEGIS_CONCURRENCY_NORMAL=3
AEGIS_CONCURRENCY_LOW=1

# Concurrency slot lease TTL in milliseconds (default: 120 000 = 2 minutes).
# Slots held by crashed workers expire after this period so they are not
# leaked permanently.
AEGIS_CONCURRENCY_LEASE_MS=120000

# ── Vector memory ─────────────────────────────────────────────────────────────
# Vector memory requires Redis Stack (redis/redis-stack-server) for FT.SEARCH.
# On plain Redis, initVectorIndex() throws instead of silently falling back to
# a per-process HNSW index — in any multi-container deploy that fallback desyncs
# memory across server/worker/dlq-worker. Only set this if you are intentionally
# running a single process against plain Redis (e.g. local dev without Docker).
# AEGIS_ALLOW_HNSW_FALLBACK=true

# How long a memory entry is retained before eviction (default: 30 days).
AEGIS_MEMORY_TTL_DAYS=30

# How often the eviction cron sweeps all active tenants (default: 1 hour).
# Fractional values are accepted (e.g. 0.5 = every 30 minutes).
AEGIS_EVICTION_INTERVAL_HOURS=1

# Over-fetch multiplier for reranking: raw KNN candidates = topK × this value.
# Higher = better recall at the cost of more comparisons (default: 3).
AEGIS_MEMORY_OVERFETCH=3

# Minimum combined quality score [0–1] required to appear in search results.
# quality = w_cosine × cosineSimilarity + w_bm25 × bm25 + w_recency × recency
# (default: 0.5).
AEGIS_MEMORY_MIN_SCORE=0.5

# Recency decay half-life in days. A memory stored this many days ago scores
# 0.5 on recency; fresher entries score closer to 1.0 (default: 7 days).
AEGIS_MEMORY_HALFLIFE_DAYS=7

# ── Vector memory reranker weights ───────────────────────────────────────────
# Three-way hybrid blend for memory reranking.
# Weights are automatically normalised so they always sum to 1.0 — you can
# set them to any positive numbers (e.g. 5 / 3 / 2) and the engine handles
# the normalisation.
#
# AEGIS_MEMORY_W_COSINE   — weight for vector cosine similarity  (default: 0.50)
# AEGIS_MEMORY_W_BM25     — weight for BM25 keyword relevance    (default: 0.30)
# AEGIS_MEMORY_W_RECENCY  — weight for exponential recency decay (default: 0.20)
#
# To disable BM25 and fall back to the old cosine+recency blend:
#   AEGIS_MEMORY_W_COSINE=0.6
#   AEGIS_MEMORY_W_BM25=0
#   AEGIS_MEMORY_W_RECENCY=0.4
AEGIS_MEMORY_W_COSINE=0.50
AEGIS_MEMORY_W_BM25=0.30
AEGIS_MEMORY_W_RECENCY=0.20

# ── BM25 parameters ───────────────────────────────────────────────────────────
# k1  — term-frequency saturation; higher values give more weight to
#        frequently-occurring query terms. Okapi BM25 default: 1.5
# b   — document-length normalisation; 1.0 = full normalisation,
#        0.0 = none. Okapi BM25 default: 0.75
AEGIS_BM25_K1=1.5
AEGIS_BM25_B=0.75

# ── Adaptive weight feedback ──────────────────────────────────────────────────
# Step size for per-tenant weight adjustment via recordMemoryFeedback().
# Weights are nudged by this amount per feedback signal and clamped to
# [0.05, 0.90] so no single component can dominate. (default: 0.02)
AEGIS_MEMORY_FEEDBACK_STEP=0.02

# ── Rate limiting (POST /task and other write endpoints) ──────────────────────
# Rolling window: max requests allowed per window per tenant/key.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
# Burst guard: independent short-spike cap.
RATE_LIMIT_BURST_MS=5000
RATE_LIMIT_BURST_MAX=20

# ── Code execution sandbox ────────────────────────────────────────────────────
# Patches generated by agents are linted and tested inside a Docker container
# so a malicious or buggy patch cannot escape the worktree, make network calls,
# or consume unbounded resources on the host.
#
# Requirements (when using Docker, the default):
#   - Docker must be running on the host (docker info must succeed).
#   - The server process must have permission to call `docker run`.
#   - The image below is pulled automatically on first use.
#
# What happens when Docker is NOT available:
#
#   ┌──────────────────────────────────┬─────────────────────────────────────┐
#   │ Condition                        │ Behaviour                           │
#   ├──────────────────────────────────┼─────────────────────────────────────┤
#   │ Docker available (any env)       │ ✅ Fully sandboxed — always used    │
#   │ CI=true (set by most CI runners) │ ⚠️  Direct exec on CI host, warned  │
#   │ AEGIS_SANDBOX_MODE=local         │ ⚠️  Direct exec on host, warned     │
#   │ AEGIS_SANDBOX_DISABLE=true       │ ⚠️  Same as above (legacy flag)     │
#   │ None of the above                │ ✖  Hard fail — step rejected safely │
#   └──────────────────────────────────┴─────────────────────────────────────┘
#
# AEGIS_SANDBOX_MODE (preferred for new configurations)
#   local  — allow unsandboxed direct execution. Use for local dev when you
#             don't have Docker. A loud warning is printed at startup.
#             NEVER set this in production.
#
# CI auto-detection
#   When CI=true is present in the environment (GitHub Actions, GitLab CI,
#   CircleCI, Travis CI, Buildkite, Jenkins, and most other platforms set this
#   automatically), sandbox.js falls back to direct execution with a warning.
#   No variable needs to be set in your workflow file — it just works.
#   For full isolation in CI, configure Docker-in-Docker (dind).
#
# AEGIS_SANDBOX_DISABLE (legacy — still works, prefer AEGIS_SANDBOX_MODE=local)
#   true — same behaviour as AEGIS_SANDBOX_MODE=local.
#
# Leave both unset in production. Docker absence will then hard-fail every
# step rather than silently downgrading to unsandboxed host execution.
# Uncomment ONLY for local dev without Docker. Never in production.
# AEGIS_SANDBOX_MODE=local
# AEGIS_SANDBOX_DISABLE=true

# Docker image used for sandboxed lint + test of JavaScript/TypeScript repos.
# Must have Node.js available. node:22-alpine is small (~60 MB) and sufficient.
AEGIS_SANDBOX_IMAGE=node:22-alpine
# With DOCKER_HOST set (remote runner / compose dind) the worktree is streamed, not
# mounted, so the node image must already contain eslint/vitest at /app/node_modules:
# build Dockerfile.sandbox and point this at it. AEGIS_SANDBOX_TRANSPORT=stream forces
# streaming without DOCKER_HOST; AEGIS_SANDBOX_STREAM_MAX_MB (256) and
# AEGIS_SANDBOX_WORKTREE_TMPFS_MB (256) cap the transfer and the in-container worktree.

# Other languages are detected from marker files at the worktree root
# (pyproject.toml/requirements.txt, go.mod, pom.xml, build.gradle) and run in
# their own image. Override any of them here:
# AEGIS_SANDBOX_IMAGE_PYTHON=python:3.12-alpine
# AEGIS_SANDBOX_IMAGE_GO=golang:1.23-alpine
# AEGIS_SANDBOX_IMAGE_MAVEN=maven:3.9-eclipse-temurin-21
# AEGIS_SANDBOX_IMAGE_GRADLE=gradle:8-jdk21
#
# Lint/test containers have no network, so dependencies are installed ahead of
# time: once per set of manifests (requirements*.txt, pyproject.toml, go.mod/go.sum,
# pom.xml, build.gradle*), in a separate container WITH network access that sees
# only a scratch copy of the repo, then mounted read-only into the runs. Python
# gets pytest and the repo's requirements; Go runs `go mod download` (skipped if
# vendor/ is committed); Java resolves Maven/Gradle plugins and dependencies.
# This step runs the repo's own build tooling with network access, like any CI
# dependency install. Turn it off to supply caches yourself:
# AEGIS_SANDBOX_AUTO_DEPS=off
# AEGIS_DEPS_CACHE_DIR=/var/cache/aegis/deps        # default: <tmpdir>/aegis-deps
# AEGIS_SANDBOX_DEPS_TIMEOUT_MS=600000              # install step timeout
# AEGIS_SANDBOX_GOPROXY=https://proxy.golang.org    # private modules need your own proxy
# Manual caches (win over the automatic one), mounted read-only at the same path:
# AEGIS_SANDBOX_PYTHON_DEPS=/srv/aegis/py-deps      # pip install --target <dir> -r requirements.txt
# AEGIS_SANDBOX_GO_DEPS=/srv/aegis/go-modcache      # GOMODCACHE=<dir> go mod download
# AEGIS_SANDBOX_JAVA_DEPS=/srv/aegis/m2             # Maven repo, or the Gradle dir holding modules-2
#
# A worktree with none of these languages FAILS lint/tests (the change would be
# unverified). Set this to skip instead:
# AEGIS_SANDBOX_ALLOW_UNSUPPORTED=true

# Memory limit per sandboxed container (Docker --memory syntax).
AEGIS_SANDBOX_MEMORY=512m

# CPU limit per sandboxed container (fractional cores allowed, e.g. 0.5).
AEGIS_SANDBOX_CPUS=1

# Wall-clock timeout in milliseconds for each sandboxed run.
# If lint or tests exceed this limit the container is killed and the step fails.
AEGIS_SANDBOX_TIMEOUT_MS=60000

# ── Per-workflow Git worktree ─────────────────────────────────────────────────
# Each workflow gets its own Git worktree directory and branch so concurrent
# workflows for the same tenant never contend on the same working directory.
#
# Root directory under which all tenant worktrees are created.
# Default: <project_root>/.aegis-worktrees
# AEGIS_WORKTREES=/var/aegis/worktrees

# Project repository root (defaults to process.cwd() at startup).
# AEGIS_REPO_ROOT=/path/to/your/repo

# Two lock TTLs control Git safety:
#
#   AEGIS_GIT_TENANT_LOCK_TTL_MS — held only during worktree creation /
#     deletion (fast git admin ops). Short because it gates worktree setup,
#     not the full apply+commit window.
#
#   AEGIS_GIT_LOCK_TTL_MS — per-workflow lock, held for the duration of
#     apply+commit within a single worktree. Must exceed the longest expected
#     apply+commit wall-time. Steps of the same workflow serialize here;
#     steps of different workflows are unaffected.
AEGIS_GIT_TENANT_LOCK_TTL_MS=10000
AEGIS_GIT_LOCK_TTL_MS=15000

# ── Per-tenant repos (GitHub App / GitLab / Bitbucket) ───────────────────────
# Setting AEGIS_REPOS_BASE enables multi-repo mode: each tenant connects its own
# repo via the GitHub App, GitLab OAuth or Bitbucket OAuth and gets its own clone at <base>/<tenantId>/repo.
# A tenant with no connected repo is rejected (POST /task → 409). When set,
# AEGIS_REPO_ROOT, AEGIS_GIT_REMOTE, AEGIS_PR_REPO and AEGIS_PR_TOKEN are ignored.
# Must be a volume shared by server and workers.
AEGIS_REPOS_BASE=/repos
# AEGIS_REPO_FETCH_INTERVAL_MS=30000
# AEGIS_GIT_AUTHOR_NAME=Aegis
# AEGIS_GIT_AUTHOR_EMAIL=aegis@users.noreply.github.com
#
# GitHub App (Settings → Developer settings → GitHub Apps):
#   Permissions: Contents RW, Pull requests RW, Metadata R
#   Callback URL: https://<host>/github/callback
#   Enable "Request user authorization (OAuth) during installation"
#   Webhook URL:  https://<host>/webhooks/github-app  (events: Installation,
#                 Installation repositories)
# AEGIS_GITHUB_APP_ID=
# AEGIS_GITHUB_APP_SLUG=
# AEGIS_GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# AEGIS_GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/github-app.pem
# AEGIS_GITHUB_APP_CLIENT_ID=
# AEGIS_GITHUB_APP_CLIENT_SECRET=
# AEGIS_GITHUB_APP_WEBHOOK_SECRET=
# AEGIS_OAUTH_STATE_SECRET=          # >= 32 random chars
# AEGIS_POST_CONNECT_URL=https://app.example.com/settings/repo
# GitHub Enterprise: AEGIS_GITHUB_API_URL / AEGIS_GITHUB_WEB_URL
#
# GitLab / Bitbucket per-tenant auth (OAuth 2.0). A tenant starts the flow with
#   POST /tenants/:id/repo/connect  {"provider": "gitlab" | "bitbucket"}
# and opens the returned installUrl. Tokens are stored AES-256-GCM encrypted in
# Redis and refreshed automatically; revocation is detected at the next refresh.
# Both providers also need AEGIS_OAUTH_STATE_SECRET (above) and the key below.
#
# AEGIS_TOKEN_ENCRYPTION_KEY=        # 32 bytes, 64 hex chars:  openssl rand -hex 32
# AEGIS_PUBLIC_URL=https://aegis.example.com   # used to build <url>/gitlab|bitbucket/callback
#
# GitLab application (Preferences/Admin → Applications): confidential, scope `api`,
#   Redirect URI https://<host>/gitlab/callback
# AEGIS_GITLAB_OAUTH_CLIENT_ID=
# AEGIS_GITLAB_OAUTH_CLIENT_SECRET=
# AEGIS_GITLAB_REDIRECT_URI=          # optional override of the default above
# Self-hosted GitLab: AEGIS_GITLAB_API_URL (https://gitlab.example.com/api/v4);
#   AEGIS_GITLAB_WEB_URL only if the web host differs from the API host.
#
# Bitbucket Cloud OAuth consumer (Workspace settings → OAuth consumers):
#   Callback https://<host>/bitbucket/callback
#   Permissions: Account Read · Repositories Read+Write · Pull requests Write
# AEGIS_BITBUCKET_OAUTH_CLIENT_ID=    # consumer key
# AEGIS_BITBUCKET_OAUTH_CLIENT_SECRET=
# Bitbucket Server / Data Center is not supported.

# ── Remote push + Pull Request / Merge Request (LEGACY single-repo mode) ─────
# Ignored when AEGIS_REPOS_BASE is set: each tenant's own GitHub App / GitLab /
# Bitbucket connection supplies repo, token and PR target. Do not use a PAT
# for multi-tenant deployments.
# Set AEGIS_GIT_REMOTE to enable pushing branches to a remote after a workflow
# merges successfully. Leave unset for fully local (no-push) operation.
# Use either a remote name (e.g. "origin") OR a full URL — not both.
# AEGIS_GIT_REMOTE=origin
# AEGIS_GIT_REMOTE=https://github.com/org/repo

# Which branch to push. Defaults to the tenant base branch
# ("aegis-tenant/<tenantId>"). Set to the special value "__workflow__" to
# push the per-workflow branch instead (useful when you want CI/review before
# merging to main).
# AEGIS_GIT_PUSH_BRANCH=__workflow__

# PR / MR provider. "github" | "gitlab" | "bitbucket" | "none" (default).
# AEGIS_PR_PROVIDER=github

# owner/repo on GitHub, numeric project ID on GitLab, or workspace/repo_slug
# on Bitbucket.
# AEGIS_PR_REPO=my-org/my-repo

# Branch the PR/MR should target (default: main).
# AEGIS_PR_TARGET_BRANCH=main

# Personal access token with repo + pull_request write scope. For Bitbucket,
# a repository/workspace access token or OAuth token (sent as Bearer).
# AEGIS_PR_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Override API base URLs for GitHub Enterprise or self-hosted GitLab.
# AEGIS_GITHUB_API_URL=https://github.example.com/api/v3
# AEGIS_GITLAB_API_URL=https://gitlab.example.com/api/v4

# ── Inbound webhooks ──────────────────────────────────────────────────────────
# Set the matching secret to validate inbound webhook requests.
# GitHub: must match the "Secret" field in the GitHub webhook settings.
# GitLab: must match the "Secret token" field in the GitLab webhook settings.
AEGIS_WEBHOOK_SECRET_GITHUB=your-github-webhook-secret
AEGIS_WEBHOOK_SECRET_GITLAB=your-gitlab-webhook-token

# Comma-separated branch name patterns (supports * wildcard).
# Only pushes/PRs targeting a matching branch trigger a workflow.
# Default: * (accept all branches).
AEGIS_WEBHOOK_BRANCH_FILTER=main,release/*

# Tenant to attribute inbound webhook jobs to (defaults to DEFAULT_TENANT).
AEGIS_WEBHOOK_TENANT=my-tenant

# ── Dead Letter Queue ─────────────────────────────────────────────────────────
# How many times the DLQ worker re-queues a failed step at CRITICAL priority
# before routing to the human review queue (default: 2).
DLQ_MAX_RETRIES=2

# Base back-off delay before the first DLQ retry in milliseconds (default: 30 s).
# Doubles each attempt; capped at 5 minutes.
DLQ_BASE_DELAY_MS=30000

# How often the DLQ staleness sweep runs per tenant in milliseconds (default: 15 min).
DLQ_STALE_SWEEP_MS=900000

# A review item is "stale" after this many milliseconds without human action
# (default: 1 hour). Stale items trigger a WARN-level alert re-emission.
DLQ_STALE_THRESHOLD_MS=3600000

# Webhook URL to receive structured alert payloads (JSON POST) from the DLQ
# worker. Optional — if unset, alerts are only written to stderr.
# AEGIS_ALERT_WEBHOOK=https://hooks.example.com/aegis-alerts

# Webhook URL to receive a JSON POST whenever a patch is held for human
# approval (APPROVAL_REQUIRED level). Falls back to AEGIS_ALERT_WEBHOOK when
# unset so a single endpoint can cover both alert types if preferred.
# AEGIS_APPROVAL_WEBHOOK=https://hooks.example.com/aegis-approval
# Slack / Discord delivery for workflow completion + failure events, sent
# alongside the webhooks above. Optional — set either, neither, or both.
# AEGIS_SLACK_WEBHOOK=https://hooks.slack.com/services/...
# AEGIS_DISCORD_WEBHOOK=https://discord.com/api/webhooks/...

# ── Merge conflict resolution strategy ───────────────────────────────────────
# Controls what finaliseWorkflow() does when a --no-ff merge fails due to
# conflicts with a concurrent workflow.
#
#   rebase  (default) — Rebase the workflow branch onto the updated base branch
#             and retry the merge with --ff-only. Resolves ordering conflicts
#             (two workflows adding to the same file) automatically. Falls back
#             to "flag" if the rebase itself encounters line-level collisions.
#
#   flag    — Abort immediately and flag the workflow for human review. Use
#             when deterministic history is required and no automated resolution
#             is acceptable.
#
# AEGIS_MERGE_STRATEGY=rebase

# ── CLI polling (cli/claude.js) ───────────────────────────────────────────────
# How often the CLI polls for workflow completion in milliseconds (default: 3 s).
# AEGIS_CLI_POLL_INTERVAL_MS=3000

# How long the CLI waits for a workflow to finish before printing a timeout
# warning in milliseconds (default: 10 minutes).
# AEGIS_CLI_POLL_TIMEOUT_MS=600000

# ── Tenant override ───────────────────────────────────────────────────────────
# Tenant ID used by the CLI when AEGIS_TENANT is set.
# Defaults to "default" when not set.
# AEGIS_TENANT=default

# ── Anomaly detection ─────────────────────────────────────────────────────────
# The in-process anomaly detector evaluates live metrics on a fixed interval and
# fires alerts (stderr + AEGIS_ALERT_WEBHOOK) when thresholds are sustained.

# How often to evaluate rules in milliseconds (default: 60 000 = 1 minute).
# ANOMALY_INTERVAL_MS=60000

# How long a threshold must be continuously breached before an alert fires
# (default: 120 000 = 2 minutes). Prevents alert storms on transient spikes.
# ANOMALY_SUSTAINED_MS=120000

# 5-minute success rate below this % triggers a warning alert (default: 80).
# ANOMALY_SUCCESS_RATE_WARN=80

# 5-minute success rate below this % triggers a critical alert (default: 50).
# ANOMALY_SUCCESS_RATE_CRIT=50

# 5-minute p95 latency above this many ms triggers a warning (default: 30 000).
# ANOMALY_P95_WARN_MS=30000

# Latency spike alert fires when 5m p95 exceeds this multiple of the 1h p95
# (default: 3 = 3×). Requires both windows to have data.
# ANOMALY_SPIKE_RATIO=3

# Retry rate above this fraction (retries/total) triggers a warning (default: 0.20 = 20%).
# ANOMALY_RETRY_RATE=0.20

# How long anomaly alerts are retained in Redis in seconds (default: 86 400 = 1 day).
# ANOMALY_ALERT_TTL_S=86400

# Maximum number of anomaly alerts stored in the Redis index (default: 200).
# ANOMALY_MAX_STORED=200

# ── Compliance audit trail ────────────────────────────────────────────────────
# HMAC signing key for the tamper-evident audit log (engine/audit-log.js).
# Every audit event is hash-chained to the previous one AND signed with this
# key, so a party with Redis access but not this key cannot forge a
# replacement chain.
#
# REQUIRED IN PRODUCTION. If unset, a random key is generated per-process at
# boot — the chain is still internally consistent but signatures cannot be
# verified across restarts or by an external auditor. Set once and keep it
# out of version control; rotating it invalidates verification of history
# signed under the old key (the events themselves are unaffected).
# Generate with the same command as above; required in production.
AEGIS_AUDIT_SIGNING_KEY=replace_with_a_long_random_secret_and_never_rotate_carelessly

# Where the Stripe billing portal sends the tenant back to (POST /billing/portal).
# BILLING_RETURN_URL=https://app.example.com/billing

# Public contact address shown on the landing/signup/legal pages. Use a
# role address on your own domain, not a personal mailbox. Unset = no
# contact links are rendered.
# AEGIS_CONTACT_EMAIL=hello@your-domain.com

# Self-serve signup is refused while AEGIS_SANDBOX_MODE=local (tenant code would
# run unsandboxed on shared infrastructure). Set true ONLY for demo/trial deploys.
# AEGIS_ALLOW_UNSANDBOXED_SIGNUP=false

# ── Spend control (engine/billing/spend-guard.js) ───────────────────────────
# Hard cap on platform-key LLM spend per tenant per month. Tier caps live in
# engine/billing/tiers.js (spend.capUsd); override per tenant with
# PUT /tenants/:id/spend. Prepaid mode: { "mode": "prepaid" } + credit top-ups.
# Cap for Stripe-backed tenants until their first PAID invoice clears (USD):
# AEGIS_UNVERIFIED_CAP_USD=5
# Operator key for PUT /tenants/:id/spend and POST /tenants/:id/credits.
# Unset = those routes are disabled (fail closed). Generate: openssl rand -hex 32
# AEGIS_ADMIN_KEY=
# Also gates PUT/DELETE /tenants/:id/sso (per-tenant OIDC config).

# ── SSO / RBAC (engine/sso.js, engine/user-store.js, engine/rbac.js) ────────
# Redirect URI registered at the IdP: <AEGIS_PUBLIC_URL>/auth/sso/callback
# (AEGIS_PUBLIC_URL and AEGIS_TOKEN_ENCRYPTION_KEY, which seals the IdP client
# secret, are defined elsewhere in this file and are both required for SSO.)
# Where the callback sends the browser (the React dashboard's URL; default "/"):
# AEGIS_DASHBOARD_URL=https://dashboard.example.com
# SSO session lifetime in hours (default 8):
# AEGIS_SESSION_TTL_HOURS=8
# BYOK (enterprise) reuses AEGIS_TOKEN_ENCRYPTION_KEY to seal tenant Anthropic keys.
