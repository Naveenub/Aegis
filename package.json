{
  "name": "aegis",
  "version": "2.0.0",
  "description": "Distributed, self-healing AI workflow engine with multi-agent orchestration, DAG execution, Git-backed rollback, and vector memory.",
  "type": "module",
  "license": "MIT",
  "author": "Naveen Badiger <badigernaveen2@gmail.com> (https://github.com/Naveenub)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Naveenub/aegis.git"
  },
  "homepage": "https://github.com/Naveenub/aegis#readme",
  "bugs": {
    "url": "https://github.com/Naveenub/aegis/issues"
  },
  "keywords": [
    "ai-agents",
    "multi-agent-orchestration",
    "llm",
    "dag",
    "workflow-engine",
    "docker-sandbox",
    "multi-tenant"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node cli/claude.js",
    "server": "node server.js",
    "worker": "node workers/agent-worker.js",
    "dlq-worker": "node workers/dlq-worker.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --project unit",
    "test:system": "vitest run --project system",
    "test:all": "vitest run",
    "test:watch": "vitest",
    "eval": "node scripts/run-prompt-eval.js",
    "billing:flush": "node scripts/billing-flush.js",
    "onboard": "node scripts/onboard-design-partner.js",
    "check": "npm run lint && npm run test:coverage",
    "test:coverage": "vitest run --coverage",
    "test:coverage:watch": "vitest --coverage"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.20.0",
    "@aws-sdk/client-sqs": "^3.600.0",
    "acorn": "^8.16.0",
    "bullmq": "^4.0.0",
    "dotenv": "^16.0.0",
    "express": "^4.18.0",
    "express-rate-limit": "^7.4.0",
    "rate-limit-redis": "^4.2.3",
    "ioredis": "^5.0.0",
    "openai": "^6.39.0",
    "pino": "^8.0.0",
    "pino-pretty": "^10.0.0",
    "prom-client": "^15.1.3",
    "redlock": "^5.0.0-beta.2",
    "pg": "^8.23.0",
    "stripe": "^22.5.0"
  },
  "optionalDependencies": {
    "hnswlib-node": "^3.0.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "vitest": "^4.1.8",
    "@vitest/coverage-v8": "1.6.0"
  }
}
