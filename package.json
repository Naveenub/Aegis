{
  "name": "aegis",
  "version": "1.5.1",
  "description": "Distributed, self-healing AI workflow engine with multi-agent orchestration, DAG execution, Git-backed rollback, and vector memory.",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node cli/claude.js",
    "server": "node server.js",
    "worker": "node workers/agent-worker.js",
    "dlq-worker": "node workers/dlq-worker.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "node scripts/run-prompt-eval.js",
    "check": "npm run lint && npm run test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.20.0",
    "acorn": "^8.16.0",
    "bullmq": "^4.0.0",
    "dotenv": "^16.0.0",
    "express": "^4.18.0",
    "express-rate-limit": "^7.4.0",
    "ioredis": "^5.0.0",
    "openai": "^6.39.0",
    "pino": "^8.0.0",
    "pino-pretty": "^10.0.0",
    "prom-client": "^15.1.3",
    "redlock": "^5.0.0-beta.2",
    "rate-limit-redis": "^4.3.1"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "vitest": "^1.6.0"
  }
}
